DirectoryIndex index.html index.php

Options -Indexes

<IfModule mod_authz_core.c>
    AuthMerging Off
    Require all granted
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
    Satisfy any
</IfModule>

# --- Compression -----------------------------------------------------------
# Until 2026-08-05 nothing was compressed except map-features.php, which gzips itself.
# Measured on the real responses of that day: JS+CSS 5,97 -> 1,73 MB, the political layer
# 2,90 -> 0,76 MB, adventures 1,81 -> 0,24 MB, the landscape layer 1,70 -> 0,48 MB. That is
# several megabytes per cold visit, and it is the same line the PHP pool keeps saturating on.
#
# No double compression: map-features.php sets Content-Encoding itself, and mod_deflate skips
# any response that already carries one. Images, fonts and webp are left alone deliberately --
# they are compressed already and running deflate over them costs CPU for nothing.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/geo+json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
</IfModule>

# --- Caching ---------------------------------------------------------------
# Ziel: Endnutzer bekommen nach einem Deploy sofort frischen Code, OHNE Hard-Reload,
# behalten aber maximale Performance. JS/CSS werden in index.html mit ?v=<contenthash>
# referenziert (Deploy-Schritt). Solche versionierten Assets duerfen "immutable" ewig
# gecacht werden (die URL aendert sich, sobald sich der Inhalt aendert). Assets ohne
# Version werden stets revalidiert (sichere Degradierung). HTML wird nie hart gecacht,
# damit die aktuellen ?v=-Hashes immer ankommen. Bilder/Fonts: moderates Caching.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # --- Commercial SEO backlink scrapers: 403 --------------------------------------
    # They crawl completely and return nothing to this project. First rule in the file so a
    # blocked request costs one regex, not a redirect chain plus PHP.
    # NOTE: Deliberately absent: facebookexternalhit, Discordbot, Twitterbot, WhatsApp and the
    #    Mastodon fetcher -- the social hub needs their link previews. Absent as well:
    #    Bytespider and ImagesiftBot, because welcoming AI crawlers is an owner decision
    #    (see the GEO allow list in robots.txt), not an oversight.
    # NOTE: A user agent is a self-declaration. This stops the honest heavy hitters; it is not
    #    a defence against anything that actually wants in.
    RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|BLEXBot|DataForSeoBot|Barkrowler|serpstatbot|MegaIndex|SeekportBot|ZoominfoBot) [NC]
    RewriteRule ^ - [F,L]
    # --- Canonical host: www -> non-www (+ https). Loop-safe: nach dem Redirect ist der Host die
    #     non-www-Variante, die ^www\. nicht mehr matcht -> kein Loop moeglich. ---
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    # --- Force HTTPS (non-www ist hier bereits kanonisch). Loop-sicher: STRATO liefert %{HTTPS}=on
    #     fuer echtes https (verifiziert: HTTPS=on, Port 443) -> feuert nur bei echtem http. ---
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    # --- Safety net for crawlers that skip robots.txt but honour headers -------------
    # Data endpoints, map tiles and uploaded images carry no indexable text: the page's
    # indexable content sits statically in index.html (h1, FAQ, JSON-LD), not in the map
    # payload. Same mechanism as VERSIONED_ASSET below -- mod_rewrite sets the variable,
    # mod_headers reads it, so no second module is needed.
    RewriteCond %{REQUEST_URI} ^/(api|tiles|uploads)/ [NC]
    RewriteRule ^ - [E=AVESMAPS_NOINDEX:1]
    # Markiere Anfragen an .js/.css MIT ?v=... als versioniert.
    RewriteCond %{QUERY_STRING} (^|&)v=
    RewriteRule \.(?:js|css)$ - [E=VERSIONED_ASSET:1]
</IfModule>

<IfModule mod_headers.c>
    # Set by the rewrite rule above for /api/, /tiles/ and /uploads/.
    Header set X-Robots-Tag "noindex" env=AVESMAPS_NOINDEX

    <FilesMatch "\.(?:js|css)$">
        # Versioniert (?v=hash): ewig + immutable cachen.
        Header set Cache-Control "public, max-age=31536000, immutable" env=VERSIONED_ASSET
        # Ohne Version: immer revalidieren (Fallback; verhindert "fuer immer stale").
        Header set Cache-Control "no-cache" env=!VERSIONED_ASSET
    </FilesMatch>

    # HTML immer revalidieren (klein), damit aktuelle Asset-Hashes ankommen.
    <FilesMatch "\.(?:html|htm)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Statische Medien/Fonts: 30 Tage cachen (aendern sich selten).
    <FilesMatch "\.(?:png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
