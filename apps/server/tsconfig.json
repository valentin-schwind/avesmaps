{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // Node runs these sources directly, so relative imports name the .ts file;
        // tsc rewrites them to .js on emit. Not set for apps/web, where .vue imports collide with it.
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "references": [{ "path": "../../packages/shared" }]
}
