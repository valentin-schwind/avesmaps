-- Rechte an den Neuigkeiten (WI-0139, Migration 0119). psql-Datei mit \gexec, wie `jobs-grants.psql`.
--
-- Vorlage fuer Claudios `avesmaps3d-db-grants` (`grants_sql_tmpl` in ops/runtime/runtime-foundation.sh): `${e}` ist die Umgebung
-- (staging, production), wie dort. Sie gehoert hinter JEDE Migration.
--
-- 🔴 Der Punkt dieser Datei: Die Routine schreibt ueber EINE Funktion, nicht mit INSERT auf die Tabelle. Damit kann sie genau eine Sache,
--    einen Entwurf anlegen - kein Aendern, kein Loeschen, kein Schreiben in `zustand` oder `freigegeben_at`, kein Zugriff auf fremde
--    Zeilen. Legacys Schluessel durfte `list` und `save`; das hier ist enger.
--
-- Fehlt die Funktion (0119 noch nicht angewandt) oder die News-Rolle (`avesmaps3d_${e}_news`), entfaellt die Zeile still.

-- 1 Die News-Rolle fuehrt `news_add` aus. Sonst niemand ausser der Migrationsrolle; die App-Rolle braucht sie nicht (von Hand angelegte
--   Eintraege schreibt sie direkt, weil dahinter ein angemeldeter Betreiber steht).
SELECT format('REVOKE EXECUTE ON FUNCTION %s FROM PUBLIC, avesmaps3d_${e}_app', p.oid::regprocedure)
  FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
 WHERE n.nspname = 'public' AND p.proname = 'news_add' \gexec
-- Ohne USAGE auf dem Schema scheitert jeder Aufruf mit „permission denied for schema public“, obwohl EXECUTE da ist
-- (Routine 2026-10-14 19:00, „news_add gescheitert bei Eintrag 0“; Claudio 2026-10-15). Nur USAGE: sehen und aufrufen, nichts lesen.
SELECT format('GRANT USAGE ON SCHEMA public TO %I', 'avesmaps3d_${e}_news')
 WHERE EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'avesmaps3d_${e}_news') \gexec
SELECT format('GRANT EXECUTE ON FUNCTION %s TO %I', p.oid::regprocedure, 'avesmaps3d_${e}_news')
  FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
 WHERE n.nspname = 'public' AND p.proname = 'news_add'
   AND EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'avesmaps3d_${e}_news') \gexec

-- 2 Die News-Rolle darf die Tabelle selbst nicht anfassen - auch nicht lesen. Sie braucht es nicht: `news_add` sagt ihr ueber den
--   Rueckgabewert, ob der Eintrag neu war. Was schon dasteht, liest die Routine ueber den oeffentlichen Lesepfad.
SELECT format('REVOKE ALL ON TABLE public.news_entry FROM %I', 'avesmaps3d_${e}_news')
 WHERE to_regclass('public.news_entry') IS NOT NULL
   AND EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'avesmaps3d_${e}_news') \gexec

-- 3 Die App-Rolle loescht nie: Ein missglueckter Satz wird versteckt, nicht spurlos (WI-0139 §3).
SELECT 'REVOKE DELETE, TRUNCATE ON news_entry FROM avesmaps3d_${e}_app'
 WHERE to_regclass('public.news_entry') IS NOT NULL \gexec
