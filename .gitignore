__pycache__/
*.py[cod]
api/config.local.php
api/.env
.env
map/google-sheets-credentials.json
map/google-sheets-token.json
map/Aventurien_routes.backup-*.svg
map/*.import.mysql.sql
tiles/stylized/
tiles/old/
tiles/politics/
layer0.json
.refactor-backup/

# Local geo-import artifact (DB-IP Lite, not for the repo)
tools/geo-import.sql
tools/geo-import.sql.gz

# Runtime-fetched Wiki Aventurica dump (server data, never the repo).
# Keep the deny-all .htaccess; ignore the downloaded dump artifacts.
uploads/dumps/*
!uploads/dumps/.htaccess

# Database backups (edit/backup.php). A full dump carries password hashes and every
# report -- it is the most sensitive artifact this project produces and must NEVER be
# committed. Keep the deny-all .htaccess; ignore every dump.
uploads/db-backups/*
!uploads/db-backups/.htaccess

# Manually-uploaded map export archives (large binaries; live on the server, not in the repo).
uploads/*.zip
uploads/map/*.zip

# Superpowers brainstorming/verify scratch space (mockups, harnesses) — never deployed
.superpowers/

# Claude Code scratch space. .claude/worktrees alone was 2,2 GB with 57 checkouts of this repo
# on 2026-08-05, none of it tracked. Two costs, both real: one git add -A would have tried to
# commit all of it (AGENTS.md forbids that command, but a convention should not be the only
# thing standing between the repo and 2,2 GB), and grep tools honour .gitignore -- two agents
# in the system test measured multiplied hit counts before they noticed they were counting
# 57 copies. launch.json stays untracked-but-visible on purpose; it is the preview config.
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Verify-Seiten: die Beweis-Harnische der Sitzungen (Mockups, Messseiten, ihre Daten).
# Sie gehoeren zur Arbeit, aber nicht in das Repo -- sie werden nie ausgeliefert, und 51
# Stueck (5,4 MB) standen dauerhaft in "git status". Das ist nicht Kosmetik: AGENTS.md §9
# verlangt "erst git status, dann NUR eigene Pfade stagen", und diese Regel ist die einzige,
# die in einem geteilten Arbeitsbaum die Arbeit fremder Sitzungen schuetzt. Sie wird
# unbefolgbar, wenn die Liste zu 56 Zeilen Rauschen wird, in denen die eigene Aenderung
# untergeht. Gleiche Begruendung wie .superpowers/ weiter oben.
verify-*
